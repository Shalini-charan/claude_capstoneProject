{
  "mcpServers": {
    "atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian",
        "--jira-projects-filter", "CLAUDE"
      ],
      "env": {
        "JIRA_URL": "https://shalini-srinivasan.atlassian.net",
        "JIRA_USERNAME": "shalini_Srinivasan@epam.com",
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "https://shalini-srinivasan.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "shalini_Srinivasan@epam.com",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
